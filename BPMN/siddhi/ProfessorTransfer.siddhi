@App:name("ProfessorTransfer")

/*
 * Incoming professor-transfer events. Siddhi validates the envelope and
 * forwards the professor's data to the communication service. The Future
 * Department supplies its own budget assessment from its local database.
 */
@source(
    type='http',
    receiver.url="http://0.0.0.0:7071/customer",
    @map(type='json', fail.on.missing.attribute='false')
)
define stream CustomerStream(
    transfer_id string,
    action string,
    within_department bool,
    professor_id string,
    professor_name string,
    salary double,
    currency string,
    salary_period string,
    current_department string,
    current_section string,
    target_department string,
    target_section string,
    professor_domain string,
    research_domain string,
    research_description string,
    research_importance double,
    current_department_available_funding double,
    dean_academic_fit bool,
    dean_funding_approved bool
);

/* Python/Camunda activity events are routed to the log writer. */
@source(
    type='http',
    receiver.url="http://0.0.0.0:7072/middleman",
    @map(type='json')
)
define stream MiddlemanStream(
    transfer_id string,
    event string,
    timestamp string,
    role string,
    payload string,
    error string
);

@sink(
    type='http',
    publisher.url='http://communication:5001/start_transfer',
    method='POST',
    @map(type='json')
)
define stream StartTransferOut(
    transferId string,
    withinDepartment bool,
    professorId string,
    professorName string,
    professorSalary double,
    salaryCurrency string,
    salaryPeriod string,
    currentDepartment string,
    currentSection string,
    targetDepartment string,
    targetSection string,
    professorDomain string,
    researchDomain string,
    researchDescription string,
    researchImportance double,
    currentDepartmentAvailableFunding double
);

@sink(
    type='http',
    publisher.url='http://logging-service:5010/log',
    method='POST',
    @map(type='json')
)
define stream Logging(
    event string,
    transfer_id string,
    timestamp string,
    role string,
    payload string,
    error string
);

define stream RoutingError(transfer_id string, error string);

/* StartTransfer reaches Zeebe through the Python communication service. */
from CustomerStream[
    action == 'StartTransfer' and
    not (transfer_id is null) and
    not (within_department is null) and
    not (professor_id is null)
]
select transfer_id as transferId,
       within_department as withinDepartment,
       professor_id as professorId,
       professor_name as professorName,
       salary as professorSalary,
       currency as salaryCurrency,
       salary_period as salaryPeriod,
       current_department as currentDepartment,
       current_section as currentSection,
       target_department as targetDepartment,
       target_section as targetSection,
       professor_domain as professorDomain,
       research_domain as researchDomain,
       research_description as researchDescription,
       research_importance as researchImportance,
       current_department_available_funding as currentDepartmentAvailableFunding
insert into StartTransferOut;

/* Invalid or unsupported envelopes are logged; they do not start BPMN. */
from CustomerStream[
    transfer_id is null or action is null or
    within_department is null or professor_id is null
]
select transfer_id,
       "transfer_id, action, within_department and professor_id are required" as error
insert into RoutingError;

from CustomerStream[not (action is null) and action != 'StartTransfer']
select transfer_id, "unsupported action" as error
insert into RoutingError;

from MiddlemanStream
select event, transfer_id, timestamp, role, payload,
       ifThenElse(error is null, "", error) as error
insert into Logging;

from RoutingError
select "Error" as event,
       transfer_id,
       convert(currentTimeMillis(), "string") as timestamp,
       "siddhi" as role,
       "" as payload,
       error
insert into Logging;
